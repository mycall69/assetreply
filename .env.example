# ECOS 인증키 — 저장소에 실제 키를 커밋하지 않는다 (헌법 원칙 II)
# https://ecos.bok.or.kr 에서 발급
ECOS_API_KEY=

# MySQL 8.0+
DB_HOST=localhost
DB_PORT=3306
DB_NAME=assetreplay
DB_USER=
DB_PASSWORD=

# 축적 탐색 시작일 (FR-002, 헌법 v4.1.0)
# 여기 값은 "이 날짜가 최초"라는 뜻이 아니라 수집을 시작할 지점일 뿐이다.
# 실제 최초 제공일은 수집 중 발견해 currency.first_available_date에 기록한다 (FR-002a).
# 2026-08-30 실측: USD 1964-05-04, JPY 1977-04-01, EUR 1994-04-11.
# 실측일보다 한 청크 앞에서 시작해 경계를 INFO-200으로 증명한다.
ECOS_PROBE_FLOOR=1960-01-01
ECOS_PROBE_START_USD=1964-01-01
ECOS_PROBE_START_JPY=1977-01-01
ECOS_PROBE_START_EUR=1994-01-01

# 조회·표시 설정 (002)
# 일자별 상세 표의 기본 행 수
DAILY_PAGE_SIZE=30
# 오늘 새로고침 잠금의 스테일 회수 기준(초). 수집 잠금보다 짧게 잡는다.
TODAY_REFRESH_LOCK_TTL_SECONDS=60
